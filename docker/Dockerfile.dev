FROM node:22-slim

# Install latest pnpm through node corepack module (standard secure way)
RUN corepack enable pnpm

# Create app directory and set right permissions BEFORE switching users
RUN mkdir -p /usr/src/app/.next && chown -R node:node /usr/src/app

# Set non-root user (node comes with user 'node' uid 1000)
USER node

WORKDIR /usr/src/app

COPY --chown=node:node package.json pnpm-lock.yaml ./
RUN pnpm install

EXPOSE 3000

# Basic healthcheck on default dev port
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

CMD ["pnpm", "run", "dev"]
